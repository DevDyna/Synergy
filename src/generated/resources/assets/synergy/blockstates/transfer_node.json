{
  "multipart": [
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "x": 180,
        "y": 90
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "x": 180,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "x": 270,
        "y": 270
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "x": 90,
        "y": 270
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/node/basic/plate"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "synergy:block/node/basic/plate",
        "y": 90
      },
      "when": {
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "synergy:block/node/basic/plate",
        "y": 180
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "synergy:block/node/basic/plate",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "synergy:block/node/basic/plate",
        "x": 270,
        "y": 270
      },
      "when": {
        "facing": "up"
      }
    },
    {
      "apply": {
        "model": "synergy:block/node/basic/plate",
        "x": 90,
        "y": 270
      },
      "when": {
        "facing": "down"
      }
    }
  ]
}