{
  "multipart": [
    {
      "apply": {
        "model": "synergy:block/pipe/basic/core"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe"
      },
      "when": {
        "north": "true|node|output"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "y": 90
      },
      "when": {
        "east": "true|node|output"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "x": 180
      },
      "when": {
        "south": "true|node|output"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "y": 270
      },
      "when": {
        "west": "true|node|output"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "x": 270
      },
      "when": {
        "up": "true|node|output"
      }
    },
    {
      "apply": {
        "model": "synergy:block/pipe/basic/pipe",
        "x": 90
      },
      "when": {
        "down": "true|node|output"
      }
    }
  ]
}