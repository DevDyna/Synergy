{
  "multipart": [
    {
      "apply": {
        "model": "synergy:block/heater/metallic/open"
      },
      "when": {
        "facing": "north",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/metallic/open",
        "y": 180
      },
      "when": {
        "facing": "south",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/metallic/open",
        "y": 90
      },
      "when": {
        "facing": "east",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/metallic/open",
        "y": 270
      },
      "when": {
        "facing": "west",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/metallic/close"
      },
      "when": {
        "facing": "north",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/metallic/close",
        "y": 180
      },
      "when": {
        "facing": "south",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/metallic/close",
        "y": 90
      },
      "when": {
        "facing": "east",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/metallic/close",
        "y": 270
      },
      "when": {
        "facing": "west",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "synergy:block/heater/fire"
      },
      "when": {
        "enabled": "true"
      }
    }
  ]
}