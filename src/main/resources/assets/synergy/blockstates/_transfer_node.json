{
  "multipart": [
    {
      "apply": { "model": "synergy:block/pipe/template/node_x" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "synergy:block/pipe/basic/pipe" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "synergy:block/pipe/basic/pipe", "y": 90 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "synergy:block/pipe/basic/pipe", "y": -90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "synergy:block/pipe/basic/pipe", "y": 180 }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "synergy:block/pipe/basic/pipe", "x": -90 }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "synergy:block/pipe/basic/pipe", "x": 90 }
    }
  ]
}
